---
// Layout.astro などの head 内で読み込む想定
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";

import { ClientRouter } from "astro:transitions";
import "../styles/_index.scss";

const fontFiles = [
	"/fonts/inter-variable.woff2",
	"/fonts/noto-sans-jp-variable.woff2",
];

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>

		<ClientRouter />

		<!-- ブラウザに最優先でフォントを確保させる -->
		{
			fontFiles.map((font) => (
				<link
					rel="preload"
					href={font}
					as="font"
					type="font/woff2"
					crossorigin="anonymous"
				/>
			))
		}
		<script is:inline>
			/**
			 * テーマを取得・適用する関数
			 */
			const applyTheme = () => {
				const theme = (() => {
					const saved = localStorage.getItem("theme");
					if (saved) return saved;
					return window.matchMedia("(prefers-color-scheme: dark)")
						.matches
						? "dark"
						: "light";
				})();
				document.documentElement.setAttribute("data-theme", theme);
			};

			// 1. 初回ロード時の適用（FOUC防止）
			applyTheme();

			// 2. ClientRouter（遷移後）の適用
			// astro:after-swap は新しいページの DOM に入れ替わった直後に発火します
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
	</head>
	<body>
		<SkipLink />
		<div class="l-wrapper">
			<Header class="l-header" />
			<main class="l-main" id="mainContents">
				<slot />
			</main>
			<Footer class="l-footer" />
		</div>
	</body>
</html>

<style is:global lang="scss">
	@use "../styles/global" as g;

	@layer layout {
		:root {
			--header-blockSize: #{g.rem(60)};
		}

		.l-wrapper {
			inline-size: 100dvi;
			min-block-size: 100dvb;
			display: grid;
			grid-template-areas:
				"header"
				"main"
				"footer";
			grid-template-rows: auto 1fr auto;
			grid-template-columns: 1fr;
		}
		.l-header {
			grid-area: header;
			inline-size: 100%;
			block-size: var(--header-blockSize);
			position: sticky;
			top: 0;
			z-index: var(--z-sticky, 100);
		}
		.l-main {
			grid-area: main;
			scroll-margin-block-start: var(--header-blockSize);
		}
		.l-footer {
			grid-area: footer;
		}
	}
</style>
