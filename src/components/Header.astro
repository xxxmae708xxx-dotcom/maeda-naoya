---
import { nav_items } from "../data/navigation";
import HeaderLogo from "../assets/header-logo.svg";
import ArrowIcon from "../assets/arrow-icon.svg";
import ColorThemeToggle from "./ColorThemeToggle.astro";
import Inner from "../layouts/Inner.astro";

interface Props {
    class?: string;
    title?: string;
    href?: string;
}

const { title = "Site Name", href = "/", class: className } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const isCurrent = (itemHref: string) => {
    const normalize = (p: string) => p.replace(/\/$/, "") || "/";
    return normalize(pathname) === normalize(itemHref);
};
---

<header id="js-header" class:list={[className, "c-header"]} data-state="closed">
    <Inner class="c-header__inner">
        <div class="c-header__logo">
            {
                isHome ? (
                    <h1 class="c-header__logoTitle">
                        <HeaderLogo width="120" />
                        <span class="u-visually-hidden">{title}</span>
                    </h1>
                ) : (
                    <a
                        href={href}
                        class="c-header__logoLink"
                        aria-label="トップページへ戻る"
                    >
                        <HeaderLogo width="120" />
                        <span class="u-visually-hidden">{title}</span>
                    </a>
                )
            }
        </div>

        <button
            id="js-drawer-open"
            class="c-header__trigger c-header__trigger--open"
            aria-controls="js-nav"
            aria-expanded="false"
            aria-label="メニューを開く"
        >
            <span class="c-header__triggerBar"></span>
        </button>

        <nav id="js-nav" class="c-header__nav" aria-hidden="true">
            <div class="c-header__navInner">
                <div class="c-header__navHeader">
                    <button
                        id="js-drawer-close"
                        class="c-header__trigger c-header__trigger--close"
                        aria-label="メニューを閉じる"
                    >
                        <span class="u-visually-hidden">閉じる</span>
                    </button>
                </div>
                <ul class="c-header__navList">
                    {
                        nav_items.map((item) => {
                            const active = isCurrent(item.href);
                            return (
                                <li class="c-header__navItem">
                                    <a
                                        href={item.href}
                                        class="c-header__navLink"
                                        aria-current={
                                            active ? "page" : undefined
                                        }
                                    >
                                        {item.label}
                                        <span class="c-header__navLink__icon">
                                            <ArrowIcon />
                                        </span>
                                    </a>
                                </li>
                            );
                        })
                    }
                </ul>
            </div>
        </nav>

        <div class="c-header__theme">
            <ColorThemeToggle />
        </div>

        <div id="js-overlay" class="c-header__overlay"></div>
    </Inner>
</header>

<script>
    const setupHeader = () => {
        const header = document.getElementById("js-header");
        const openBtn = document.getElementById("js-drawer-open");
        const closeBtn = document.getElementById("js-drawer-close");
        const nav = document.getElementById("js-nav");
        const overlay = document.getElementById("js-overlay");

        if (!header || !openBtn || !closeBtn || !nav || !overlay) return;

        const toggleMenu = (isOpen: boolean) => {
            header.setAttribute("data-state", isOpen ? "opened" : "closed");
            openBtn.setAttribute("aria-expanded", String(isOpen));
            nav.setAttribute("aria-hidden", String(!isOpen));

            if (isOpen) {
                document.body.style.overflow = "hidden";
                closeBtn.focus();
            } else {
                document.body.style.overflow = "";
                if (document.activeElement === closeBtn) openBtn.focus();
            }
        };

        openBtn.addEventListener("click", () => toggleMenu(true));
        closeBtn.addEventListener("click", () => toggleMenu(false));
        overlay.addEventListener("click", () => toggleMenu(false));

        window.addEventListener("keydown", (e) => {
            if (
                e.key === "Escape" &&
                header.getAttribute("data-state") === "opened"
            ) {
                toggleMenu(false);
            }
        });

        // スクロール時のクラス付与（最適化）
        let ticking = false;
        const updateHeader = () => {
            header.classList.toggle("is-scroll", window.scrollY > 20);
            ticking = false;
        };
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    window.requestAnimationFrame(updateHeader);
                    ticking = true;
                }
            },
            { passive: true },
        );

        // リサイズ時のスクロールロック解除のみJSで担保
        window.addEventListener(
            "resize",
            () => {
                if (window.innerWidth >= 768) {
                    document.body.style.overflow = "";
                }
            },
            { passive: true },
        );
    };

    setupHeader();
    document.addEventListener("astro:after-swap", setupHeader);
</script>

<style is:global lang="scss">
    @use "/src/styles/global" as g;

    @layer component {
        .c-header {
            --header-bg: transparent;
            --header-shadow: none;

            position: sticky;
            top: 0;
            z-index: 100;
            display: grid;
            place-items: center;
            background: var(--header-bg);
            box-shadow: var(--header-shadow);
            transition:
                background 0.3s ease,
                box-shadow 0.3s ease;

            &.is-scroll {
                --header-bg: var(--color-bg-surface, #fff);
                --header-shadow: var(--shadow-elevation-low);
            }
        }

        .c-header__inner {
            display: grid;
            grid-template-areas: "nav logo theme";
            grid-template-columns: 1fr auto 1fr;
            column-gap: g.rem(16);
            align-items: center;
            @include g.mq-min("md") {
                grid-template-areas: "logo nav theme";
            }
        }

        /* --- Logo --- */
        .c-header__logo {
            grid-area: logo;
            display: grid;
            justify-content: start;
        }

        .c-header__logoTitle,
        .c-header__logoLink {
            display: grid;
            place-items: center;
            color: var(--color-text-base);
            inline-size: g.rem(90);
            margin: 0;

            :global(svg) {
                inline-size: 100%;
                block-size: auto;
            }

            @include g.mq-min("md") {
                inline-size: g.rem(120);
            }
        }

        @media (any-hover: hover) {
            .c-header__logoLink:hover {
                color: var(--color-primary);
                transition: color 0.3s ease;
            }
        }

        /* --- Triggers --- */
        .c-header__trigger {
            background: none;
            border: none;
            cursor: pointer;
            padding: g.rem(8);
            color: var(--color-text-base);

            &--open {
                grid-area: nav;
                position: relative;
                inline-size: g.rem(40);
                block-size: g.rem(40);

                @include g.mq-min("md") {
                    display: none;
                }

                .c-header__triggerBar {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    inline-size: g.rem(24);
                    block-size: 2px;
                    background: currentColor;

                    &::before,
                    &::after {
                        content: "";
                        position: absolute;
                        inline-size: 100%;
                        block-size: 2px;
                        background: currentColor;
                        transition: transform 0.3s;
                    }
                    &::before {
                        top: g.rem(-8);
                    }
                    &::after {
                        top: g.rem(8);
                    }
                }
            }

            &--close {
                position: relative;
                block-size: var(--header-blockSize);
                background-color: var(--color-surface-darkest);
                aspect-ratio: 1;

                &::before,
                &::after {
                    content: "";
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    inline-size: g.rem(24);
                    block-size: 2px;
                    background: var(--color-text-on-inverse);
                }
                &::before {
                    transform: translate(-50%, -50%) rotate(45deg);
                }
                &::after {
                    transform: translate(-50%, -50%) rotate(-45deg);
                }
            }
        }

        /* --- Navigation --- */
        .c-header__nav {
            // SP: Drawer Style (mq-max)
            @include g.mq-max("md") {
                position: fixed;
                inset: 0 auto 0 0;
                inline-size: min(85%, g.rem(320));
                background: var(--color-bg-surface);
                z-index: 110;

                transform: translateX(-100%);
                visibility: hidden;
                overflow-y: auto;
                pointer-events: none;
                transition: none;

                .c-header[data-state="opened"] & {
                    transform: translateX(0);
                    visibility: visible;
                    pointer-events: auto;
                    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.1);
                    transition:
                        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                        visibility 0.4s;
                }
            }

            // PC: Horizontal Style (mq-min)
            @include g.mq-min("md") {
                position: static;
                inline-size: auto;
                background: transparent;
                transform: none !important;
                visibility: visible !important;
                overflow: visible;
                pointer-events: auto !important;
                transition: none !important;
            }
        }
        .c-header__navInner {
            display: flex;
            flex-direction: column;
            @include g.mq-min("md") {
                padding: 0;
            }
        }

        .c-header__navHeader {
            @include g.mq-max("md") {
                block-size: var(--header-blockSize);
                display: grid;
                align-items: center;
                justify-content: start;
            }
            @include g.mq-min("md") {
                display: none;
            }
        }

        .c-header__navList {
            display: flex;
            flex-direction: column;
            list-style: none;
            padding: 0;
            margin: 0;

            @include g.mq-min("md") {
                flex-direction: row;
                gap: g.rem(32);
            }
        }

        .c-header__navItem {
            @include g.mq-max("md") {
                border-block-end: g.rem(1) solid var(--color-border-base);
                &:first-child {
                    border-block-start: g.rem(1) solid var(--color-border-base);
                }
            }
        }

        .c-header__navLink {
            display: grid;
            align-items: center;
            color: var(--color-text-base);
            text-decoration: none;
            text-transform: uppercase;
            font-weight: 500;
            @media (any-hover: hover) {
                &:hover {
                    color: var(--color-primary);
                }
            }

            @include g.mq-max("md") {
                block-size: 3lh;
                grid-template-columns: 1fr auto;
                padding-inline: g.rem(32) g.rem(24);
                font-size: g.rem(16);
                &[aria-current="page"] {
                    background-color: var(--color-surface-soft);
                }
            }

            @include g.mq-min("md") {
                position: relative;
                padding-block-end: g.rem(6);
                font-size: g.rem(14);
                transition: color 0.3s ease;

                &::after {
                    content: "";
                    position: absolute;
                    inset-inline-start: 50%;
                    inset-block-end: 0;
                    inline-size: 100%;
                    block-size: g.rem(2);
                    background: var(--color-primary, #007aff);
                    transform: translateX(-50%) scaleX(0);
                    transition: transform 0.3s ease;
                }
                &[aria-current="page"]::after {
                    transform: translateX(-50%) scaleX(1);
                }
            }
        }

        .c-header__navLink__icon {
            @include g.mq-max("md") {
                display: grid;
                block-size: 0.75lh;
                aspect-ratio: 8 / 12;
            }
            @include g.mq-min("md") {
                display: none;
            }
        }

        .c-header__theme {
            grid-area: theme;
            justify-self: end;
        }

        /* --- Overlay --- */
        .c-header__overlay {
            @include g.mq-max("md") {
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.4);
                backdrop-filter: blur(4px);
                opacity: 0;
                visibility: hidden;
                z-index: 105;
                transition:
                    opacity 0.3s ease,
                    visibility 0.3s; // ここも閉じる時用にtransition追加

                .c-header[data-state="opened"] & {
                    opacity: 1;
                    visibility: visible;
                }
            }

            @include g.mq-min("md") {
                display: none !important;
            }
        }
    }
</style>
